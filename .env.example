# AI Agent Command Center — environment configuration
# Copy to .env (START.bat does this on first run) and fill in the values.
# NEVER commit .env. Values left empty here must be set by you.

# ---- Super Admin (created on first start) ----
ADMIN_USERNAME=admin
# Required. Choose a strong password (min 12 chars). Startup refuses an empty value.
ADMIN_PASSWORD=

# ---- Security ----
# Required. Generated automatically by START.bat on first run if empty.
# Manual: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Required. Fernet key used to encrypt API keys/tokens at rest. Generated by START.bat if empty.
# Manual: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# WARNING: losing this key makes stored credentials unreadable.
APP_ENCRYPTION_KEY=

# ---- PostgreSQL ----
POSTGRES_USER=acc
POSTGRES_PASSWORD=
POSTGRES_DB=acc

# ---- RabbitMQ ----
RABBITMQ_USER=acc
RABBITMQ_PASSWORD=

# ---- Ports on your machine ----
FRONTEND_PORT=3000
API_PORT=8000
RABBITMQ_UI_PORT=15672

# ---- AI providers ----
# Optional. Providers are normally configured from the web UI (Settings > Providers),
# where keys are stored encrypted. A Claude.ai subscription does NOT include API access;
# an Anthropic API key comes from https://console.anthropic.com
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Agent sandbox ----
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_TIMEOUT_SECONDS=900

# ---- Optional: tracing (OpenTelemetry, OTLP/HTTP collector URL, e.g. http://localhost:4318) ----
# OTEL_EXPORTER_OTLP_ENDPOINT=
# LOG_FORMAT=json

# ---- Local (non-Docker) runs only — docker-compose.yml sets these itself ----
# REDIS_URL=redis://localhost:6379/0
# BROWSER_BRIDGE_URL=http://127.0.0.1:8100
# PLATFORM_INTERNAL_URL=http://127.0.0.1:8000
# BROWSER_PROFILES_DIR=./data/browser-profiles   (Browser Bridge is EXPERIMENTAL and disabled in the UI by default)
# BROWSER_HEADLESS=true                          (false shows the window so a person can sign in)
# SKILLS_DIR=./data/skills                       (skills are only installed from here or by upload)
# CLI_SANDBOX_IMAGE=acc/cli:latest               (docker/cli/Dockerfile — build it yourself)

# Optional services. The experimental Browser Bridge needs a ~1.5 GB Playwright image, so it is not built or
# started unless you enable it here (then run ./install.sh or START.bat again):
# COMPOSE_PROFILES=browser-bridge
